rules_version = '2';

// Fired Arts Regional Growth HQ — shared workspace rules.
// Only the two owner Google accounts may read or write workspace data.
// Deploy: Firebase console → Firestore Database → Rules, or `firebase deploy --only firestore:rules`.

service cloud.firestore {
  match /databases/{database}/documents {
    function isOwner() {
      return request.auth != null
        && request.auth.token.email != null
        && request.auth.token.email.lower() in [
          "kylematthewberry@gmail.com",
          "rochelleberry731@gmail.com"
        ];
    }

    // Shared workspace state lives under /hq/state/{key}.
    match /hq/{document=**} {
      allow read, write: if isOwner();
    }

    // Deny everything else by default.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
